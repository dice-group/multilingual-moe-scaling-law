      "datatrove_manifest_api_window_requests": 800,
      "datatrove_manifest_api_window_seconds": 300,
      "require_hf_auth": true
    },
    "tokenizer_training": {
      "enabled": true,
      "output_dir": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k_manifest/tokenizers"
    },
    "tokenization": {
      "language_set_id": "k200",
      "output_dir": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k_manifest/tokenized_megatron",
      "model_name": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k_manifest/tokenizers/scaling_fw2_k200_64k/tokenizer.model",
      "megatron_slurm_array_ranks": 256
    },
    "summary": {
      "summary_csv": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k_manifest/summary.csv",
      "gate_json": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k_manifest/gate.json"
    }
  },
