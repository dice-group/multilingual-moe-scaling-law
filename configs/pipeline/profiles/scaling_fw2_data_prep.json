    "run_naming": {
      "experiment_tag": "scaling-fw2-k200-tokenizer-64k",
      "language_count_hint": 200
    },
    "sample": {
      "language_set_id": "k200",
      "output_dir": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k/sampled"
    },
    "tokenizer_training": {
      "enabled": true,
      "output_dir": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k/tokenizers"
    },
    "tokenization": {
      "language_set_id": "k200",
      "output_dir": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k/tokenized_megatron",
      "megatron_slurm_array_ranks": 64
    },
    "summary": {
      "summary_csv": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k/summary.csv",
      "gate_json": "outputs/pipeline_runs/scaling_fw2_k200_tokenizer_64k/gate.json"
    }
  },
